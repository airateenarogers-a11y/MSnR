FROM python:3.12-slim
WORKDIR /app
COPY requirements.lock ./
COPY wheelhouse /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels --require-hashes -r requirements.lock \
    && pip install --no-cache-dir --no-index --no-deps --find-links=/wheels msnr-terminal==0.1.0 \
    && rm -rf /wheels \
    && useradd --uid 10001 --create-home msnr \
    && mkdir -p /app/var && chown -R msnr:msnr /app/var
COPY config ./config
COPY docs ./docs
RUN chmod -R a+rX /app/config /app/docs
USER msnr
ENV MPLCONFIGDIR=/app/var/cache/matplotlib XDG_CACHE_HOME=/app/var/cache
EXPOSE 8000
CMD ["msnr","serve","--host","0.0.0.0","--port","8000"]
